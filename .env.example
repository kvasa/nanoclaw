# ── Authentication ────────────────────────────────────────────────────
# Claude Code OAuth token (required — one of CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=
# Alternatively, use a direct API key:
# ANTHROPIC_API_KEY=
# Alternatively, use a bearer auth token (alternative auth path):
# ANTHROPIC_AUTH_TOKEN=
# Optional: custom Anthropic API base URL
# ANTHROPIC_BASE_URL=

# ── Assistant ─────────────────────────────────────────────────────────
ASSISTANT_NAME="Jarmil"
# Set to true if the assistant has its own WhatsApp number (not shared with user)
# ASSISTANT_HAS_OWN_NUMBER=false
# Timezone (default: system TZ)
# TZ=Europe/Prague

# ── LLM ───────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-4-8
# Log detail level: full | summary | none
LLM_LOG_DETAIL=full
LOG_LEVEL=debug

# ── Container resource limits ─────────────────────────────────────────
# Caps per agent container so one runaway agent can't exhaust the host.
# Set any to empty to disable that limit. (--pids-limit is Docker-only.)
# CONTAINER_MEMORY=2g
# CONTAINER_CPUS=2
# CONTAINER_PIDS_LIMIT=512

# ── Container ─────────────────────────────────────────────────────────
# CONTAINER_IMAGE=nanoclaw-agent
# CONTAINER_TIMEOUT=300000
# CONTAINER_MAX_OUTPUT_SIZE=100000
# MAX_CONCURRENT_CONTAINERS=3
# IDLE_TIMEOUT=300000
# CREDENTIAL_PROXY_PORT=8384
# CREDENTIAL_PROXY_HOST=host.docker.internal
# Dedicated Docker network for NanoClaw containers (bare-metal Linux: the
# credential proxy binds to this network's gateway instead of the shared
# docker0 bridge, so unrelated containers on the host can't reach it).
# If you override CREDENTIAL_PROXY_HOST above, make sure that address is
# still reachable from containers on this network — it becomes the proxy's
# bind IP and the container's host.docker.internal target instead of the
# network gateway.
# CONTAINER_NETWORK=nanoclaw

# ── HTTP API server ───────────────────────────────────────────────────
# Server only starts when API_TOKEN is set.
# API_TOKEN=
# API_PORT=3002
# API_GROUP_ID=assistant
# API_SLACK_CHANNEL_ID=

# ── Slack channel ─────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ONLY=false

# ── Gmail channel ────────────────────────────────────────────────────
# GMAIL_ENABLED=false
# Sender allowlist (fail closed): with neither of the two vars below set,
# inbound emails do NOT trigger the agent. Choose one of:
#   1) Comma-separated list of allowed sender emails
# GMAIL_ALLOWED_SENDERS=
#   2) Comma-separated list of allowed sender domains
# GMAIL_ALLOWED_DOMAINS=
#   3) Explicit opt-out: allow ALL senders to trigger the agent (no allowlist)
# GMAIL_ALLOW_ALL_SENDERS=1
# Rate limits
# GMAIL_RATE_LIMIT_PER_SENDER=10
# GMAIL_RATE_LIMIT_GLOBAL=50
# GMAIL_RATE_LIMIT_OUTGOING=20
# GMAIL_RATE_LIMIT_READ_EMAILS=100
# GMAIL_RATE_LIMIT_WINDOW_MS=3600000

# ── Apple Calendar (CalDAV) ──────────────────────────────────────────
# APPLE_ID=
# APPLE_APP_PASSWORD=
# CALDAV_BASE_URL=https://caldav.icloud.com

# ── Garmin Connect ───────────────────────────────────────────────────
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# ── Rohlik MCP ───────────────────────────────────────────────────────
# RHL_EMAIL=
# RHL_PASS=

# ── Optional integrations ────────────────────────────────────────────
# OpenAI API key — enables voice-message transcription (Whisper) + TTS
# OPENAI_API_KEY=
# Gemini API key — enables the generate_image MCP tool in agent containers
# GEMINI_API_KEY=
# Optional Gemini overrides for generate_image (defaults shown):
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ── Backup ───────────────────────────────────────────────────────────
# BACKUP_PASSWORD=your-secure-password-here
# Slack channel for encrypted backup uploads (overrides auto-resolved #backups)
# BACKUP_SLACK_CHANNEL=

# ── Retention ────────────────────────────────────────────────────────
# Days of message history to keep (default 90). Also limits how far back
# an agent can see — getMessagesSince reads from this table.
# MESSAGE_RETENTION_DAYS=90
# Days of scheduled-task run logs to keep (default 30)
# TASK_LOG_RETENTION_DAYS=30
